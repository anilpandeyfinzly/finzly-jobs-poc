# kafka-scheduler-demo configuration. Copy to `.env` or export before running.

# HTTP bind address for this demo's API.
HTTP_ADDR=0.0.0.0:8090

# Local Kafka broker started by ../../docker-compose.yml (PLAINTEXT).
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Topic finzly-jobs-poc publishes scheduled fires to (scheduler -> orchestrator).
KAFKA_TOPIC=finzly.jobs.trigger.due

# Consumer group; use a fresh id to re-read from the offset reset point.
KAFKA_GROUP_ID=kafka-scheduler-demo

# earliest = read the whole topic; latest = only messages published after start.
KAFKA_AUTO_OFFSET_RESET=latest

# Log level (tracing EnvFilter syntax).
RUST_LOG=info
